<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ocg_ivory</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_start_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ocg_ivory</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/ocg_ivory</item>
        <item name="android:navigationBarColor">@color/ocg_ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ocg_ivory</item>
        <item name="android:statusBarColor">@color/ocg_ivory</item>
        <item name="android:navigationBarColor">@color/ocg_ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
